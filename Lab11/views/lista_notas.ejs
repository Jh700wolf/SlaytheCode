<%- include('includes/_header') %>
<div class="rows">
    <% for(let nota of notas) { %>
        <div class="rows">
            <%= nota.nombre %>
        </div>
        <%= console.log(nota) %>
        <img class="thumbnail" src="/uploads/<%= nota.imagen %>"
        alt="Imagen de <%= nota.nombre %>">
    <% } %>
</div>