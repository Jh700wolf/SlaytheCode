<!doctype html>
<html class="no-js" lang="es" dir="ltr">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Lab 10</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/foundation-sites/dist/css/foundation.min.css">
    </head>
    <body>
        <div class="grid-x">
                <div class="top-bar">
                <div class="top-bar-left">
                    <ul class="dropdown menu" data-dropdown-menu>
                    <li class="menu-text">Bienvenido a mi Lab 10!</li>
                    <li><a href="https://get.foundation/sites/docs/kitchen-sink.html">Kitchen Sink de Foundation</a></li>
                    <li><a href="https://get.foundation/sites/docs/xy-grid.html">Guia para el xy grid</a></li>
                    <li><a href="https://get.foundation/sites/docs/dropdown-menu.html">Guia para el menu</a></li>
                    <% if (isLoggedIn) { %>
                        <li><a href="/plantas/agregar">Agregar Planta</a></li>
                        <li><a href="/users/logout" class="button">LOGOUT</a></li>
                        <li><stong><%= username %></stong></li>
                    <% } else { %>
                        <li><a href="/users/login" class="button">LOGIN</a></li>
                    <% } %>
                    </ul>
                </div>
                <div class="top-bar-right">
                    <ul class="menu">
                    <form action="/notas/busqueda" method="POST">
                        <li><input type="search" placeholder="Buscar?"id="busqueda" name="busqueda"></li>
                        <li><button type="submit" class="button">Buscar</button></li>
                    </form>
                    </ul>
                </div>
                </div>
        </div>